# Базовый URL GREEN-API. Менять обычно не нужно.
VITE_GREEN_API_URL=https://api.green-api.com

# true — запросы идут через dev-прокси Vite (/green-api) в обход CORS.
# false — браузер обращается к GREEN-API напрямую.
VITE_USE_PROXY=false

# Необязательно: предзаполнить форму входа при локальной разработке,
# чтобы не вводить креды на каждой перезагрузке. В git не коммитить.
VITE_DEV_ID_INSTANCE=
VITE_DEV_API_TOKEN_INSTANCE=
